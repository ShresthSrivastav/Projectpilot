# ─── REQUIRED: Authentication ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print('ak-admin-' + secrets.token_hex(32))"
ADMIN_API_KEY=
USER_API_KEY=

# ─── REQUIRED: Token Encryption (for GitHub token storage) ───────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=

# ─── Ollama (Local Models) ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
MODEL_FAST=qwen2.5-coder:1.5b
MODEL_BALANCED=qwen2.5-coder:7b
MODEL_POWERFUL=qwen2.5-coder:14b
CONTEXT_FAST=You are a fast Python coding assistant. Write clean, concise, runnable code only.
CONTEXT_BALANCED=You are a thoughtful senior engineer. Prioritise correctness and readability.
CONTEXT_POWERFUL=You are an expert software architect. Produce comprehensive, well-documented code.
LLM_TIMEOUT=180
LLM_MAX_RETRIES=3

# ─── Cloud LLM Provider (Google Gemma via OpenAI-compatible API) ────────────
# Get your API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
CLOUD_MODEL=gemma-4-26b-a4b-it

# ─── Optional: Anthropic ────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=8501

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PATH=./chroma_data

# ─── Storage ──────────────────────────────────────────────────────────────────
GENERATED_PROJECTS_DIR=./generated_projects
MEMORY_STORE_DIR=./memory_store

# ─── Cleanup daemon ───────────────────────────────────────────────────────────
ZIP_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Sandbox ──────────────────────────────────────────────────────────────────
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT=60
SANDBOX_MEMORY=256m
SANDBOX_CPU=0.5

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERATE=5
RATE_LIMIT_BENCHMARK=10
RATE_LIMIT_EVALUATION=10
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_WINDOW=60
