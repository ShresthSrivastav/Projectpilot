# ProjectPilot Production Environment Configuration
# Copy this file to .env and fill in the values

# ─── Authentication ───────────────────────────────────────────────
# Generate secure random strings: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=your-admin-api-key-here
USER_API_KEY=your-user-api-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# ─── LLM Configuration ───────────────────────────────────────────
# Google Gemini API key (for cloud model)
GOOGLE_API_KEY=your-google-api-key-here

# Ollama endpoint (only needed if running local models on this VM)
OLLAMA_BASE_URL=http://localhost:11434

# ─── Paths ────────────────────────────────────────────────────────
CHROMA_PATH=/app/chroma_data
GENERATED_PROJECTS_DIR=/app/generated_projects
MEMORY_STORE_DIR=/app/memory_store

# ─── Application ──────────────────────────────────────────────────
BACKEND_URL=http://127.0.0.1:5000
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true

# ─── Security ─────────────────────────────────────────────────────
# Token encryption key for secure token storage
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_ENCRYPTION_KEY=your-token-encryption-key-here

# Set to false in production (uses real auth)
SKIP_AUTH=false

# ─── Cleanup ──────────────────────────────────────────────────────
ZIP_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600
